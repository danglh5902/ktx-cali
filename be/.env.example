# Supabase project settings → Project Settings → API / Database
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-project-jwt-secret

# Postgres connection string — use the "Session" pooler (port 5432) or direct
# connection, NOT the transaction pooler (port 6543): SET LOCAL inside a
# transaction (used for RLS session variables, see core/db/request-context.ts)
# requires a session-scoped connection.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
