# Supabase project settings → Project Settings → API / Database.
# SUPABASE_URL must be just the project origin — no trailing path (not
# ".../rest/v1/"). core/auth/supabase-auth-client.ts always appends
# "/auth/v1/..." itself for login/refresh/logout.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=your-project-jwt-secret
# "anon public" key — needed as the apikey header when this backend calls
# Supabase Auth on the user's behalf (modules/auth). Not the service_role key.
SUPABASE_ANON_KEY=your-anon-public-key

# Postgres connection strings — use the "Session pooler" (port 5432), NOT the
# "Transaction pooler" (port 6543): SET LOCAL inside a transaction (used for
# RLS session variables, see core/db/request-context.ts) requires every
# statement in that transaction to land on the same backend connection,
# which only the session pooler guarantees.
#
# Get it from Supabase Dashboard → Project Settings → Database → Connection
# string → tab "Session pooler". Do NOT use the "Direct connection" host
# (db.xxxxxxxx.supabase.co) — on many networks it only has an IPv6 DNS
# record and fails with ENOTFOUND unless your network/host has IPv6
# connectivity or you've bought Supabase's IPv4 add-on.

# App runtime connection. MUST be a role WITHOUT the BYPASSRLS attribute —
# never `postgres` (Supabase's default role has `rolbypassrls = true`, which
# makes it ignore every RLS policy silently). Create a least-privilege role
# first (see be/src/core/db/rls/README.md), then point this at it:
DATABASE_URL=postgresql://ktx_app.xxxxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Schema-owning connection, used only by `pnpm db:generate` / `db:migrate` /
# `db:apply-rls` (CREATE TABLE / CREATE POLICY need the owner). This is the
# `postgres` role. Optional — falls back to DATABASE_URL if omitted, but
# then RLS enforcement is NOT real (see the role's rolbypassrls note above),
# so only skip this for quick local scratch DBs, never for anything shared.
MIGRATE_DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
